{
	"name": "@aomc-server/block-ui",
	"version": "0.3.1",
	"description": "Blocky, Minecraft-inspired Preact UI components, styles and helpers shared by the AOMC apps.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AOMC-Server/block-ui.git"
	},
	"exports": {
		".": "./src/index.ts",
		"./theme": "./src/theme/index.ts",
		"./events": "./src/lib/events.ts",
		"./format": "./src/lib/format.ts",
		"./csv": "./src/lib/csv.ts",
		"./errors": "./src/lib/errors.ts",
		"./hooks": "./src/hooks/index.ts",
		"./width": "./src/lib/widthStore.ts",
		"./reorder": "./src/lib/reorder.ts",
		"./markdown": "./src/lib/markdown.ts",
		"./menu": "./src/lib/menu.ts",
		"./css": {
			"types": "./css/index.d.ts",
			"default": "./css/index.css"
		},
		"./css/*": "./css/*",
		"./fonts/*": "./fonts/*",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"css",
		"fonts",
		"README.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"demo": "vite --config demo/vite.config.ts --configLoader runner",
		"demo:build": "vite build --config demo/vite.config.ts --configLoader runner",
		"test": "bun test",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@preact/signals": "^2.11.4",
		"preact": "^11.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@happy-dom/global-registrator": "^21.0.4",
		"@preact/preset-vite": "^2.10.6",
		"@preact/signals": "^2.11.4",
		"@types/bun": "^1.4.5",
		"happy-dom": "^21.0.4",
		"preact": "^11.2.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8"
	}
}
